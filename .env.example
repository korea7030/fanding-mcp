# Email login credentials (if using email login method)
FANDING_EMAIL=
FANDING_PASSWORD=

# OpenAI Whisper API key (for video transcription)
OPENAI_API_KEY=

# 아래 둘은 선택사항입니다. 기본값은 패키지 설치 위치의 ./data 이며,
# 실행 시 작업 디렉토리(cwd)와 무관하게 항상 이 위치를 씁니다.

# 세션 파일 저장 위치만 따로 바꾸고 싶을 때
# SESSION_DIR=/path/to/sessions

# DB/브라우저 프로필/세션을 전부 다른 위치로 옮기고 싶을 때
# FANDING_DATA_DIR=/path/to/data
