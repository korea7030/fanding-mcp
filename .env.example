# Email login credentials (if using email login method)
FANDING_EMAIL=
FANDING_PASSWORD=

# OpenAI Whisper API key (for video transcription)
OPENAI_API_KEY=

# --- 경로 설정 (전부 선택사항이지만, Docker/Hermes 환경에서는 절대 경로로 명시하기를 권장) ---

# DB/브라우저 프로필/세션을 저장할 위치.
# 미설정 시: <패키지 루트>/data가 이미 있으면 그 위치, 없으면 ~/.fanding-mcp/data
# FANDING_DATA_DIR=/opt/data/profiles/invest-bot/workspace/fanding-mcp-data

# 세션 파일 저장 위치만 따로 바꾸고 싶을 때 (기본값: $FANDING_DATA_DIR/sessions)
# SESSION_DIR=/opt/data/profiles/invest-bot/workspace/fanding-mcp-data/sessions

# Playwright 브라우저 설치 위치. 설치할 때와 실행할 때 같은 값이어야 합니다.
# PLAYWRIGHT_BROWSERS_PATH=/opt/data/profiles/invest-bot/workspace/fanding-playwright

# --- 전사 API 커스터마이징 (선택사항, 기본값: OpenAI Whisper) ---
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_MODEL=whisper-1
