{
  "name": "@korea7030/fanding-mcp",
  "version": "1.0.0",
  "description": "MCP server for fanding.kr post/video summarization, search, and tracking",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "fanding-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "fanding",
    "model-context-protocol"
  ],
  "author": "korea7030",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "playwright": "^1.61.1",
    "undici": "^7.28.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  }
}
